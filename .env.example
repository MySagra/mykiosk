# ─── MySagra Kiosk ────────────────────────────────────────────────────────
# URL completo di ogni app. Se vuoto, il pulsante non compare.
# Porte prese da dockercompose/ (installazione standard MySagra).

# --- Esempio on-site (server 192.168.50.100, rete 192.168.50.x) ----------
MYAMMINISTRATORE_URL=https://192.168.50.100:81
MYCASSA_URL=https://192.168.50.100
MYNUMERI_URL=https://192.168.50.100:3033
MYCOMANDA_URL=http://192.168.50.100:3035

KIOSK_TITLE=MySagra
# Secondi tra un controllo di stato e l'altro (0 = disattivato)
KIOSK_CHECK_INTERVAL=15

# --- Esempio cloud (sostituisci i domini con quelli reali) ---------------
# MYAMMINISTRATORE_URL=https://admin.tuasagra.example
# MYCASSA_URL=https://cassa.tuasagra.example
# MYNUMERI_URL=https://numeri.tuasagra.example
# MYCOMANDA_URL=https://comande.tuasagra.example
# KIOSK_TITLE=MySagra
# KIOSK_CHECK_INTERVAL=30
