# ─── MySagra Kiosk ────────────────────────────────────────────────────────
# Indirizzo del server MySagra, come nel docker compose generale
# (es. 192.168.50.100 on-site, localhost per provare tutto su un PC).
SERVER_IP=192.168.50.100

# URL completo di ogni app, costruito da SERVER_IP con le porte del docker
# compose generale. Lascia vuoto un valore (es. MYCLIENTI_URL=) per nascondere
# quell'app.
MYAMMINISTRATORE_URL=http://${SERVER_IP}:3030
MYCASSA_URL=http://${SERVER_IP}:3031
MYNUMERI_URL=http://${SERVER_IP}:3033
MYCOMANDA_URL=http://${SERVER_IP}:3035
MYCLIENTI_URL=http://${SERVER_IP}:3034

# Secondi tra un controllo di stato e l'altro (0 = disattivato)
KIOSK_CHECK_INTERVAL=15

# --- Esempio cloud: niente SERVER_IP, un dominio per app ------------------
# MYAMMINISTRATORE_URL=https://admin.tuasagra.example
# MYCASSA_URL=https://cassa.tuasagra.example
# MYNUMERI_URL=https://numeri.tuasagra.example
# MYCOMANDA_URL=https://comande.tuasagra.example
# MYCLIENTI_URL=https://ordina.tuasagra.example
# KIOSK_CHECK_INTERVAL=30
